# Konfigurasi backend untuk penggunaan lokal di komputer pribadi.
# Salin sebagai backend/.env. Jangan commit file .env atau data keuangan.

APP_NAME=Personal Finance Tracker
APP_ENV=local
APP_DEBUG=false

# Local-only: jangan ubah ke 0.0.0.0 tanpa memasang autentikasi terlebih dahulu.
APP_HOST=127.0.0.1
APP_PORT=8000

# Jalankan backend dari folder backend/ agar path relatif ini konsisten.
APP_DATABASE_URL=sqlite:///./data/finance.db

# Origin Vite lokal; bukan rahasia dan tidak digunakan untuk menyimpan kredensial.
APP_FRONTEND_ORIGIN=http://localhost:5173

# Jangan menambahkan SECRET_KEY sampai autentikasi remote benar-benar diperlukan.
