      "css": ".ds-periods{display:flex;gap:.5rem;}.ds-period{font-family:\"Manrope\",\"Segoe UI\",sans-serif;display:flex;min-width:0;flex-direction:column;gap:.35rem;padding:.65rem .85rem;border:0;background:transparent;border-radius:.65rem;color:var(--muted);font-size:.75rem;text-align:left;cursor:pointer;}.ds-period span:last-child{color:var(--foreground);font-weight:650;}.ds-period[aria-pressed=\"true\"]{background:var(--accent-bg);color:var(--primary);}.ds-period:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(prefers-reduced-motion:no-preference){.ds-period{transition:background-color 160ms ease,color 160ms ease;}}"
