      "css": ".ds-button-secondary{font-family:\"Manrope\",\"Segoe UI\",sans-serif;min-height:2.75rem;padding:.625rem .875rem;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--card);color:var(--foreground);font-size:.875rem;font-weight:550;cursor:pointer;}.ds-button-secondary:hover:not(:disabled){background:var(--muted-bg);}.ds-button-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-button-secondary:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:no-preference){.ds-button-secondary{transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease;}.ds-button-secondary:hover:not(:disabled){transform:translateY(-1px);}.ds-button-secondary:active:not(:disabled){transform:translateY(1px);}}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
