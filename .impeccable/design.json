      "description": "Bordered editable control with visible focus and invalid states.",
      "html": "<label class=\"ds-field\">Deskripsi<input class=\"ds-input\" placeholder=\"Deskripsi transaksi\"></label>",
      "css": ".ds-field{font-family:\"Manrope\",\"Segoe UI\",sans-serif;display:flex;flex-direction:column;gap:.375rem;color:var(--foreground);font-size:.875rem;font-weight:500;}.ds-input{font-family:\"Manrope\",\"Segoe UI\",sans-serif;min-width:0;min-height:2.75rem;padding:.625rem .75rem;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--card);color:var(--foreground);font-size:1rem;caret-color:var(--accent);}.ds-input::placeholder{color:var(--muted);opacity:1;}.ds-input:hover:not(:disabled){border-color:var(--muted);}.ds-input:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-input[aria-invalid=\"true\"]{border-color:#b91c1c;}.ds-input:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:no-preference){.ds-input{transition:border-color 160ms ease;}}"
