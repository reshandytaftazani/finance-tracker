      "html": "<button class=\"ds-button-danger\">Hapus transaksi</button>",
      "css": ".ds-button-danger{font-family:\"Manrope\",\"Segoe UI\",sans-serif;min-height:2.75rem;padding:.625rem .875rem;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--card);color:var(--foreground);font-size:.875rem;font-weight:550;cursor:pointer;background:#b91c1c;color:white;border-color:#b91c1c;}.ds-button-danger:hover:not(:disabled){background:#991b1b;}.ds-button-danger:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-button-danger:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:no-preference){.ds-button-danger{transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease;}.ds-button-danger:hover:not(:disabled){transform:translateY(-1px);}.ds-button-danger:active:not(:disabled){transform:translateY(1px);}}"
    },
