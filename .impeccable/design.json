      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing primary action treatment.",
      "html": "<button class=\"ds-button-primary\">Catat Transaksi</button>",
      "css": ".ds-button-primary{font-family:\"Manrope\",\"Segoe UI\",sans-serif;min-height:2.75rem;padding:.625rem .875rem;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--card);color:var(--foreground);font-size:.875rem;font-weight:550;cursor:pointer;background:var(--primary);color:var(--primary-foreground);border-color:var(--primary);}.ds-button-primary:hover:not(:disabled){background:color-mix(in srgb,var(--primary),var(--foreground) 12%);}.ds-button-primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-button-primary:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:no-preference){.ds-button-primary{transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease;}.ds-button-primary:hover:not(:disabled){transform:translateY(-1px);}.ds-button-primary:active:not(:disabled){transform:translateY(1px);}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
